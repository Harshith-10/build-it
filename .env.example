# ─── App URL ──────────────────────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=buildit
DB_PORT=5432
DB_SSL=false
DATABASE_URL=postgresql://postgres:your_database_password@localhost:5432/buildit

# ─── JET Server (Code Execution Engine) ───────────────────────────────────────
JET_SERVER_URL=http://localhost:4000
JET_HMAC_SECRET=your_jet_hmac_secret_here
JET_HMAC_KEY_ID=kid-ba2fbe48123a5eaf

# ─── Groq AI (Optional Viva / AI Grading) ─────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── ShieldIt Extension Proctoring & Lockdown ─────────────────────────────────
