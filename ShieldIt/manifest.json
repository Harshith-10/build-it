{
  "manifest_version": 3,
  "name": "ShieldIt - Exam & Lab Lockdown",
  "version": "1.0.1",
  "description": "Official secure exam environment and lockdown extension for BuildIt.",
  "permissions": [
    "management",
    "tabs",
    "system.display",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["test_sandbox.html", "test_sandbox.js", "icons/*", "content.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://*/*"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ShieldIt Proctor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
